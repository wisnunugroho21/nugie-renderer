{
  "name": "nugie-renderer",
  "private": false,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx benchmarks/run.ts",
    "bench:anim": "tsx benchmarks/animation.ts",
    "bench:maintenance": "tsx benchmarks/maintenance.ts",
    "bench:frame": "tsx benchmarks/frame.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:lib && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run typecheck && npm test && npm run build:lib && npm run verify:package"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "draco3d": "^1.5.7",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "description": "WebGPU renderer with an ECS runtime: PBR, clustered lighting, shadows, fog, GPU-driven culling, animation, particles, glTF",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./animation/*": {
      "types": "./dist/animation/*.d.ts",
      "import": "./dist/animation/*.js"
    },
    "./app/*": {
      "types": "./dist/app/*.d.ts",
      "import": "./dist/app/*.js"
    },
    "./assets/*": {
      "types": "./dist/assets/*.d.ts",
      "import": "./dist/assets/*.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./ecs/*": {
      "types": "./dist/ecs/*.d.ts",
      "import": "./dist/ecs/*.js"
    },
    "./geometry/*": {
      "types": "./dist/geometry/*.d.ts",
      "import": "./dist/geometry/*.js"
    },
    "./math/*": {
      "types": "./dist/math/*.d.ts",
      "import": "./dist/math/*.js"
    },
    "./particles/*": {
      "types": "./dist/particles/*.d.ts",
      "import": "./dist/particles/*.js"
    },
    "./picking/*": {
      "types": "./dist/picking/*.d.ts",
      "import": "./dist/picking/*.js"
    },
    "./profiling/*": {
      "types": "./dist/profiling/*.d.ts",
      "import": "./dist/profiling/*.js"
    },
    "./scene/*": {
      "types": "./dist/scene/*.d.ts",
      "import": "./dist/scene/*.js"
    },
    "./streaming/*": {
      "types": "./dist/streaming/*.d.ts",
      "import": "./dist/streaming/*.js"
    },
    "./visibility/*": {
      "types": "./dist/visibility/*.d.ts",
      "import": "./dist/visibility/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "keywords": [
    "webgpu",
    "renderer",
    "ecs",
    "gltf",
    "game"
  ],
  "peerDependencies": {
    "@webgpu/types": ">=0.1.40"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  }
}
