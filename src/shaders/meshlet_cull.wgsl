// Meshlet culling: one thread per meshlet. A meshlet that survives the frustum and normal-cone tests appends its triangle
// indices to a compacted index buffer; args[0] (the indexCount of a drawIndexedIndirect) counts what was written. The args
// buffer is cleared by the technique's clear node before this runs; thread 0 writes the static words of the draw.

struct Meshlet {
  sphere: vec4<f32>,   // object-space bounding sphere (x, y, z, radius)
  cone: vec4<f32>,     // object-space normal cone: axis xyz, cutoff = sin(spread) (>= 1: never cone-culled)
  range: vec4<u32>,    // x = first index in srcIndices, y = index count
};

// The bindings meshlets, srcIndices, dstIndices and args (array<atomic<u32>>) are generated by the meshlet-cull technique
// (see MeshletCuller.ts), which also supplies the parameters as variables.
fn plane(i: u32) -> vec4<f32> {
  switch i {
    case 0u: { return /*$(Variable:plane0)*/; }
    case 1u: { return /*$(Variable:plane1)*/; }
    case 2u: { return /*$(Variable:plane2)*/; }
    case 3u: { return /*$(Variable:plane3)*/; }
    case 4u: { return /*$(Variable:plane4)*/; }
    default: { return /*$(Variable:plane5)*/; }
  }
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
  let i = gid.x;
  if (i == 0u) {
    // [indexCount (accumulated below), instanceCount, firstIndex, baseVertex, firstInstance]
    atomicStore(&args[1], 1u);
    atomicStore(&args[2], 0u);
    atomicStore(&args[3], /*$(Variable:baseVertex)*/);
    atomicStore(&args[4], /*$(Variable:firstInstance)*/);
  }
  if (i >= /*$(Variable:meshletCount)*/) { return; }
  // object -> world (rotation + translation + UNIFORM scale)
  let model = mat4x4<f32>(/*$(Variable:model0)*/, /*$(Variable:model1)*/, /*$(Variable:model2)*/, /*$(Variable:model3)*/);
  let eye = /*$(Variable:eye)*/;      // xyz = world-space camera position, w = the model's uniform scale (radius multiplier)
  let m = meshlets[i];
  let center = (model * vec4<f32>(m.sphere.xyz, 1.0)).xyz;
  let radius = m.sphere.w * eye.w;
  // world-space frustum planes, inward normals: inside <=> dot(n, p) + d >= 0
  for (var p = 0u; p < 6u; p = p + 1u) {
    let pl = plane(p);
    if (dot(pl.xyz, center) + pl.w < -radius) { return; }
  }
  let cutoff = m.cone.w;
  if (cutoff < 1.0) {
    let toMeshlet = center - eye.xyz;
    let dist = length(toMeshlet);
    if (dist > radius) {
      let axis = normalize((model * vec4<f32>(m.cone.xyz, 0.0)).xyz);
      if (dot(toMeshlet, axis) / dist > cutoff + radius / dist) { return; }
    }
  }
  let n = m.range.y;
  let first = m.range.x;
  let dst = atomicAdd(&args[0], n);
  for (var k = 0u; k < n; k = k + 1u) { dstIndices[dst + k] = srcIndices[first + k]; }
}
